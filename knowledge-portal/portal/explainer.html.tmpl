<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{SUBJECT}}</title>
<style>
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    color: #1a1a1a;
    background: #fafafa;
    line-height: 1.6;
  }
  .wrap { max-width: 720px; margin: 48px auto; padding: 0 24px; }
  header {
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 32px;
    padding-bottom: 16px;
  }
  header .audience {
    display: inline-block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
    background: #f3f4f6;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 12px;
  }
  h1 { font-size: 28px; margin: 0 0 6px 0; }
  .subtitle { color: #6b7280; font-size: 14px; }
  h2 { font-size: 18px; margin-top: 28px; }
  h3 { font-size: 15px; }
  code {
    background: #f3f4f6;
    padding: 2px 6px;
    border-radius: 4px;
    font-family: "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
  pre {
    background: #f3f4f6;
    padding: 14px 16px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13px;
  }
  a { color: #2563eb; }
  blockquote {
    border-left: 3px solid #e5e7eb;
    margin: 16px 0;
    padding: 4px 0 4px 16px;
    color: #6b7280;
  }
  table { border-collapse: collapse; width: 100%; margin: 16px 0; font-size: 14px; }
  th, td { border: 1px solid #e5e7eb; padding: 8px 12px; text-align: left; vertical-align: top; }
  th { background: #f3f4f6; }
  footer {
    color: #6b7280;
    font-size: 12px;
    margin-top: 48px;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
  }
  @media print {
    body { background: white; }
    .wrap { margin: 0; max-width: none; }
  }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <span class="audience">{{AUDIENCE}}</span>
    <h1>{{SUBJECT}}</h1>
    <div class="subtitle">{{TOPIC}} · last updated {{LAST_UPDATED}}</div>
  </header>

  <article>
    {{BODY}}
  </article>

  <footer>
    Part of the <a href="../index.html">Knowledge Portal</a>. Self-contained — open offline, print, or attach to email.
  </footer>
</div>
</body>
</html>
