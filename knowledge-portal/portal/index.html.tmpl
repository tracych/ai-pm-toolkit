<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Knowledge Portal</title>
<style>
  :root {
    --bg: #fafafa;
    --panel: #ffffff;
    --ink: #1a1a1a;
    --muted: #6b7280;
    --accent: #2563eb;
    --border: #e5e7eb;
    --code-bg: #f3f4f6;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    color: var(--ink);
    background: var(--bg);
    line-height: 1.55;
  }
  .layout { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; }
  nav.side {
    background: var(--panel);
    border-right: 1px solid var(--border);
    padding: 24px 18px;
    position: sticky;
    top: 0;
    height: 100vh;
    overflow-y: auto;
  }
  nav.side h1 { font-size: 16px; margin: 0 0 4px 0; }
  nav.side .subtitle { color: var(--muted); font-size: 12px; margin-bottom: 18px; }
  nav.side h2 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 22px 0 6px 0;
  }
  nav.side ul { list-style: none; margin: 0; padding: 0; }
  nav.side li { margin: 0; }
  nav.side a {
    display: block;
    padding: 5px 8px;
    color: var(--ink);
    text-decoration: none;
    font-size: 13px;
    border-radius: 4px;
  }
  nav.side a:hover { background: var(--code-bg); }
  nav.side a.active { background: var(--accent); color: white; }
  main {
    padding: 36px 48px;
    max-width: 880px;
  }
  main .toolbar {
    margin-bottom: 24px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  main input[type="search"] {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 14px;
    background: var(--panel);
  }
  main .meta {
    color: var(--muted);
    font-size: 12px;
  }
  .kb-section {
    display: none;
    padding-bottom: 60px;
    border-bottom: 1px solid var(--border);
  }
  .kb-section.active { display: block; }
  h1, h2, h3, h4 { line-height: 1.25; }
  h1 { font-size: 28px; margin-top: 0; }
  h2 { font-size: 20px; margin-top: 32px; }
  h3 { font-size: 16px; margin-top: 24px; }
  h4 { font-size: 14px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  p { margin: 12px 0; }
  a { color: var(--accent); }
  code {
    background: var(--code-bg);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: "SF Mono", Menlo, Consolas, monospace;
  }
  pre {
    background: var(--code-bg);
    padding: 14px 16px;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 13px;
  }
  pre code { background: none; padding: 0; }
  blockquote {
    border-left: 3px solid var(--border);
    margin: 16px 0;
    padding: 4px 0 4px 16px;
    color: var(--muted);
  }
  .kb-table {
    border-collapse: collapse;
    width: 100%;
    margin: 16px 0;
    font-size: 14px;
  }
  .kb-table th, .kb-table td {
    border: 1px solid var(--border);
    padding: 8px 12px;
    text-align: left;
    vertical-align: top;
  }
  .kb-table th { background: var(--code-bg); font-weight: 600; }
  hr { border: 0; border-top: 1px solid var(--border); margin: 32px 0; }
  footer {
    color: var(--muted);
    font-size: 12px;
    padding: 32px 0 12px 0;
    border-top: 1px solid var(--border);
    margin-top: 40px;
  }
  @media (max-width: 720px) {
    .layout { grid-template-columns: 1fr; }
    nav.side { position: static; height: auto; }
    main { padding: 24px; }
  }
</style>
</head>
<body>
<div class="layout">
  <nav class="side">
    <h1>Knowledge Portal</h1>
    <div class="subtitle">{{TOPIC_COUNT}} topics · {{DEEP_COUNT}} deep dives · {{EXPLAINER_COUNT}} explainers</div>

    <h2>Topics</h2>
    <ul id="nav-topics">{{NAV_TOPICS}}</ul>

    <h2>Deep dives</h2>
    <ul id="nav-deep">{{NAV_DEEP_DIVES}}</ul>

    <h2>Explainers</h2>
    <ul id="nav-explainers">{{NAV_EXPLAINERS}}</ul>
  </nav>

  <main>
    <div class="toolbar">
      <input type="search" id="search" placeholder="Search topics (Ctrl/⌘+K)…" autocomplete="off">
      <span class="meta">Built {{BUILD_TS}}</span>
    </div>

    {{SECTIONS}}

    <footer>
      Generated by <a href="https://github.com/tracych/ai-pm-toolkit/tree/main/knowledge-portal">knowledge-portal</a>.
      Single self-contained HTML. No CDN. Stdlib-only build.
    </footer>
  </main>
</div>

<script>
(function () {
  var sections = Array.prototype.slice.call(document.querySelectorAll('.kb-section'));
  var navLinks = Array.prototype.slice.call(document.querySelectorAll('nav.side a[data-target]'));
  var search = document.getElementById('search');

  function show(id) {
    sections.forEach(function (s) { s.classList.toggle('active', s.id === id); });
    navLinks.forEach(function (a) { a.classList.toggle('active', a.getAttribute('data-target') === id); });
    if (location.hash !== '#' + id) {
      history.replaceState(null, '', '#' + id);
    }
    window.scrollTo({ top: 0, behavior: 'instant' });
  }

  navLinks.forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      show(a.getAttribute('data-target'));
    });
  });

  function initialShow() {
    var hash = (location.hash || '').replace('#', '');
    if (hash && document.getElementById(hash)) {
      show(hash);
    } else if (sections.length) {
      show(sections[0].id);
    }
  }
  initialShow();
  window.addEventListener('hashchange', initialShow);

  // simple in-page search: highlight matching sections in nav
  function doSearch(q) {
    q = (q || '').trim().toLowerCase();
    navLinks.forEach(function (a) {
      var target = a.getAttribute('data-target');
      var sec = document.getElementById(target);
      var hit = !q || (sec && sec.textContent.toLowerCase().indexOf(q) !== -1);
      a.style.display = hit ? '' : 'none';
    });
  }
  search.addEventListener('input', function () { doSearch(search.value); });

  // Ctrl/⌘+K focuses search
  document.addEventListener('keydown', function (e) {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      search.focus();
      search.select();
    }
  });
})();
</script>
</body>
</html>
