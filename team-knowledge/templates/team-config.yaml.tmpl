# Team brain config
# Generated by /brain-init. Edit the placeholders below.

team_name: "<Your Team Name>"
team_slug: "<your-team-slug>"
manager_username: "<username>"

# Staleness threshold — contributor files older than this trigger a warning in /brain-evolve.
stale_threshold_days: 14

# Roster — one entry per teammate. Sub-team is free-text; used for grouping in CLAUDE.md.
roster:
  - name: "<Full Name>"
    username: "<username>"
    role: "<M2 / M1 / IC / TL / etc.>"
    sub_team: "<optional sub-team label>"
  # add as many as needed

# Data sources — identifiers for whatever systems your team uses.
# /brain-ingest is connector-agnostic; these are just IDs your own ingest step will read.
data_sources:
  # Examples — keep, replace, or remove as appropriate for your stack.
  chat_space_id: "<chat-space-id>"          # e.g. Slack channel, Google Chat space, Teams channel
  task_system: "<task-system-name>"         # e.g. Linear, Jira, GitHub Issues, Notion
  task_project_id: "<task-project-id>"
  code_repo: "<org/repo or repo URL>"
  doc_drive_id: "<drive-folder-id>"         # e.g. Google Drive, Notion DB, SharePoint
  wiki_space: "<wiki-space-id>"

# Folder identifiers on a shared drive (optional — only if your brain mirrors to one)
folders:
  status_reports_folder_id: ""
  contributors_folder_id: ""

# Compaction overrides (optional) — defaults are in templates/contributor.md.tmpl
compaction_overrides:
  # deliverables_days: 14
  # documents_days: 14
